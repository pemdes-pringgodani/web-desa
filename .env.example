# Backend Configuration
PORT=3000
NODE_ENV=development

# Database Connection String
# Local Docker PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/web_desa_db?schema=public"

# Supabase Production PostgreSQL Example:
# DATABASE_URL="postgresql://postgres.xxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Auth Keys
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Google Maps API Key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Seeding Admin Credentials
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# CORS Single Frontend Origin
# Ganti dengan URL Vercel frontend Anda saat deploy production
FRONTEND_URL="http://localhost:3001"

# Supabase Storage Buckets
SUPABASE_STORAGE_BUCKET_UMKM="umkm"
SUPABASE_STORAGE_BUCKET_NEWS="news"
SUPABASE_STORAGE_BUCKET_PROFILE="village-profile"

# Optional: Custom allowed origins for local dev (comma-separated)
# ALLOWED_DEV_ORIGINS="192.168.1.50,custom-domain.local"

